---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostCard from '../components/PostCard.astro';
import Tile from '../components/Tile.astro';
import { CATEGORY_LABEL } from '../content/config';
import home from '../data/home.json';

const tiles = home.tiles.filter((t) => !t.draft);

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const byPrimary = (cat: string) =>
  allPosts.filter((p) => p.data.primaryCategory === cat);

// Six fills two complete rows of three. A seventh would hang alone on a row
// of its own, so the overflow goes to the Reading page instead.
const HOME_MAX = 6;
const foundationalAll = byPrimary('foundational-docs');
const trainingGroundsAll = byPrimary('training-grounds');
const foundationalPosts = foundationalAll.slice(0, HOME_MAX);
const trainingGroundsPosts = trainingGroundsAll.slice(0, HOME_MAX);
const portalsPosts = byPrimary('the-portals');

// The v2-03 FLAT visualisation carries no headline type of its own, so it does
// not fight the wordmark sitting over it.
const heroImage = '/images/CivicAI_Visualisation_v2-03_FLAT.jpg';
const heroAlt =
  'Illustration of a street where civic AI is already at work: air quality, road, soil and tree sensors mounted on light poles, with people walking, cycling and using wheelchairs moving through it, picked out in magenta and purple.';

function categoryLabelsFor(post: (typeof allPosts)[number]) {
  const cats = post.data.categories ?? [];
  if (cats.length > 0) {
    return cats.map((c) => CATEGORY_LABEL[c]).join(' · ');
  }
  if (post.data.primaryCategory) {
    return CATEGORY_LABEL[post.data.primaryCategory];
  }
  return undefined;
}
---
<BaseLayout
  title="Civic Interplay"
  description="A think and do space for agentic civics and civic AI."
  ogImage={heroImage}
>
  <Hero
    image={heroImage}
    imageAlt={heroAlt}
    beforeGlitch="Civic "
    glitchWord="Interplay"
    tagline="A think and do space for agentic civics and civic AI"
    hotspots={home.hotspots}
    titleDot={home.titleDot}
  />

  <main class="container sections">

    {tiles.length > 0 && (
      <section class="tiles-section">
        <SectionHeading title="What's New" />
        <ul class="tile-grid">
          {tiles.map((t) => (
            <li>
              <Tile id={t.id} type={t.type} kicker={t.kicker} cta={t.cta} href={t.href} alt={t.alt} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {foundationalPosts.length > 0 && (
      <section>
        <SectionHeading title="Foundational Docs" />
        <div class="post-grid">
          {foundationalPosts.map((p) => (
            <PostCard
              href={`/${p.slug}/`}
              title={p.data.title}
              excerpt={p.data.excerpt}
              category={p.data.primaryCategory}
              categoryLabel={categoryLabelsFor(p)}
              accent={p.data.accent}
              image={p.data.featureImage}
              imageAlt={p.data.featureImageAlt}
              video={p.data.featureVideo}
              videoWebm={p.data.featureVideoWebm}
            />
          ))}
        </div>
        {foundationalAll.length > HOME_MAX && (
          <p class="section-more">
            <a href="/reading/">View all in Reading</a>
          </p>
        )}
      </section>
    )}

    {trainingGroundsPosts.length > 0 && (
      <section>
        <SectionHeading title="Training Grounds" />
        <div class="post-grid">
          {trainingGroundsPosts.map((p) => (
            <PostCard
              href={`/${p.slug}/`}
              title={p.data.title}
              excerpt={p.data.excerpt}
              category={p.data.primaryCategory}
              categoryLabel={categoryLabelsFor(p)}
              accent={p.data.accent}
              image={p.data.featureImage}
              imageAlt={p.data.featureImageAlt}
              video={p.data.featureVideo}
              videoWebm={p.data.featureVideoWebm}
            />
          ))}
        </div>
        {trainingGroundsAll.length > HOME_MAX && (
          <p class="section-more">
            <a href="/reading/">View all in Reading</a>
          </p>
        )}
      </section>
    )}

    {portalsPosts.length > 0 && (
      <section>
        <SectionHeading title="The Portals" />
        <div class="post-grid">
          {portalsPosts.map((p) => (
            <PostCard
              href={`/${p.slug}/`}
              title={p.data.title}
              excerpt={p.data.excerpt}
              category={p.data.primaryCategory}
              categoryLabel={categoryLabelsFor(p)}
              accent={p.data.accent}
              image={p.data.featureImage}
              imageAlt={p.data.featureImageAlt}
              video={p.data.featureVideo}
              videoWebm={p.data.featureVideoWebm}
            />
          ))}
        </div>
      </section>
    )}

  </main>

  <style>
    .section-more {
      margin: 1.4rem 0 0;
      font-family: var(--heading);
      font-size: 0.82rem;
      letter-spacing: 0.03em;
    }

    .section-more a {
      color: var(--purple);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .tiles-section {
      margin-bottom: 3.5rem;
    }







    .tile-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.6rem;
    }

    /* Two 4:5 tiles side by side on a phone leaves ~160px each, which is too
       narrow for the call to action underneath. One column instead. */
    @media (max-width: 620px) {
      .tile-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
  </style>
</BaseLayout>
