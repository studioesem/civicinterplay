---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORY_LABEL } from '../content/config';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long' });

// Field notes belong in the archive too. They are readings of a sort, and
// otherwise they only exist on the home page and the About page.
const fieldNotes = (await getCollection('fieldnotes'))
  .filter((n) => !n.data.draft)
  .map((n) => ({
    href: `/field-notes/${n.slug}/`,
    title: n.data.title,
    excerpt: n.data.description,
    categoryLabel: 'Field note',
    accent: 'periwinkle' as const,
    image: `/images/tiles/${n.data.tileId}-560.webp`,
    imageAlt: n.data.imageAlt,
    date: formatDate(n.data.publishedAt),
    sortKey: n.data.publishedAt.valueOf(),
    category: undefined,
  }));

const entries = [
  ...posts.map((p) => ({
    href: `/${p.slug}/`,
    title: p.data.title,
    excerpt: p.data.excerpt,
    categoryLabel: p.data.primaryCategory ? CATEGORY_LABEL[p.data.primaryCategory] : undefined,
    accent: p.data.accent,
    image: p.data.featureImage,
    imageAlt: p.data.featureImageAlt,
    date: formatDate(p.data.publishedAt),
    sortKey: p.data.publishedAt.valueOf(),
    category: p.data.primaryCategory,
    video: p.data.featureVideo,
    videoWebm: p.data.featureVideoWebm,
  })),
  ...fieldNotes,
].sort((a, b) => b.sortKey - a.sortKey);
---
<BaseLayout
  title="Reading"
  description="Essays, resources and foundational documentation on civic agencies, planetary citizenship and co-intelligent technologies."
>
  <main class="container reading">
    <header class="reading-header">
      <p class="reading-eyebrow">Civic Interplay / Think</p>
      <h1>Reading</h1>
      <p class="reading-intro">
        Essays, Resources and Foundational Documentation.
      </p>
    </header>

    <div class="post-grid">
      {entries.map((e) => (
        <PostCard
          href={e.href}
          title={e.title}
          excerpt={e.excerpt}
          category={e.category}
          categoryLabel={e.categoryLabel}
          accent={e.accent}
          date={e.date}
          image={e.image}
          imageAlt={e.imageAlt}
          video={e.video}
          videoWebm={e.videoWebm}
        />
      ))}
    </div>
  </main>

  <style>
    .reading {
      padding: 3rem 2rem 4rem;
      max-width: 1100px;
    }

    .reading-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--border);
    }

    .reading-eyebrow {
      font-family: var(--heading);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 0.6rem;
    }

    .reading-header h1 {
      font-family: var(--heading);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 300;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }

    .reading-intro {
      font-family: var(--body);
      font-size: 1rem;
      color: var(--text-dim);
      max-width: 60ch;
    }

    @media (max-width: 640px) {
      .reading {
        padding: 2rem 1rem 3rem;
      }
    }
  </style>
</BaseLayout>
