---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ReadingCard from '../components/ReadingCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import readingsData from '../data/readings.json';
import talksData from '../data/talks.json';

// Reading: Readings on civic AI and surrounds, Essays, Notes,
// Field notes. Project posts move to Projects; "What can you do here?" is
// retired from the listings (its page still exists).

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

// The old About manifesto becomes an essay under its own name.
const RETITLE: Record<string, string> = { 'what-is-civic-interplay': 'The macro age' };

const formatDate = (d: Date) => d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long' });

const card = (p: (typeof posts)[number], label: string, accent: 'purple' | 'terracotta' | 'cream') => ({
  href: `/${p.slug}/`,
  title: RETITLE[p.slug] ?? p.data.title,
  excerpt: p.data.excerpt,
  label,
  accent,
  image: p.data.featureImage,
  imageAlt: p.data.featureImageAlt,
  date: formatDate(p.data.publishedAt),
  video: p.data.featureVideo,
  videoWebm: p.data.featureVideoWebm,
});

// Each post's Section (set in the CMS) decides where it is listed.
const essays = posts.filter((p) => p.data.section === 'essay').map((p) => card(p, 'Essay', 'purple'));
const notes = posts.filter((p) => p.data.section === 'note').map((p) => card(p, 'Note', 'terracotta'));
const experiments = posts.filter((p) => p.data.section === 'experiment').map((p) => card(p, 'Experiment', 'cream'));

const fieldNotes = [
  ...(await getCollection('fieldnotes'))
    .filter((n) => !n.data.draft)
    .map((n) => ({
      href: `/field-notes/${n.slug}/`,
      title: n.data.title,
      excerpt: n.data.description,
      image: `/images/tiles/${n.data.tileId}-560.webp`,
      imageAlt: n.data.imageAlt,
      date: formatDate(n.data.publishedAt),
    })),
  {
    href: '/listening/',
    title: 'Listening to an emergent field',
    excerpt: 'Live searches for the vocabulary of civic AI across the research literature: a dated snapshot of how the field is talking.',
    image: '/images/tiles/listening-chart-560.webp',
    imageAlt: 'Bar chart of research mentions: AI governance dwarfs civic AI and data centres plus community benefit.',
    date: undefined,
  },
];

const talks = talksData.talks;
// Hidden entries (e.g. links emailed to add@in.civicinterplay.io) wait for review in the CMS.
const publications = readingsData.readings.filter((r) => !('draft' in r && r.draft));
// Tags across all visible readings, most used first, for the filter row.
const tagCounts = new Map<string, number>();
for (const r of publications) for (const t of ('tags' in r ? (r.tags as string[]) : [])) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);
---
<BaseLayout title="Reading" description="Publications from the field of Civic AI, Participatory AI, and governing infrastructural AI. Essays and Field notes explore ideas and practices out in the open.">

  <main class="container reading">
    <header class="reading-header">
      <p class="eyebrow">Reading <a class="rss" href="/rss.xml" title="Subscribe to Reading by RSS"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="3" cy="13" r="2" fill="currentColor"/><path d="M1 7a8 8 0 0 1 8 8M1 2a13 13 0 0 1 13 13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>RSS</a></p>
      <h1>Reading</h1>
      <p class="standfirst">
        Publications from the field of Civic AI, Participatory AI, and
        governing infrastructural AI. Essays and Field notes explore ideas and
        practices out in the open, alongside presentations.
      </p>
    </header>

    <nav class="pills" aria-label="Reading sections">
      <ul>
        <li><a href="#publications">Readings on civic AI and surrounds <span class="count">{publications.length}</span></a></li>
        <li><a href="#essays">Essays <span class="count">{essays.length}</span></a></li>
        <li><a href="#notes">Notes <span class="count">{notes.length}</span></a></li>
        {experiments.length > 0 && <li><a href="#experiments">Experiments <span class="count">{experiments.length}</span></a></li>}
        <li><a href="#field-notes">Field notes <span class="count">{fieldNotes.length}</span></a></li>
        <li><a href="#talks">Presentations <span class="count">{talks.length}</span></a></li>
      </ul>
    </nav>

    <p class="tracker">
      <span class="tracker-label">Tracking the field</span>
      <a href="/listening/">Listening to an emergent field</a>: live searches of the research
      literature for participatory AI, civic AI and AI sovereignty.
    </p>

    <section id="publications" class="rsec">
      <SectionHeading title="Readings on civic AI and surrounds" />
      {allTags.length > 0 && (
        <div class="tag-filter" role="group" aria-label="Filter readings by tag">
          <button type="button" class="tag-btn" aria-pressed="true" data-tag="">All</button>
          {allTags.map((t) => <button type="button" class="tag-btn" aria-pressed="false" data-tag={t}>{t}</button>)}
        </div>
      )}
      <div class="post-grid">
        {publications.map((r) => (
          <ReadingCard title={r.title} authors={r.authors} publisher={r.publisher} year={r.year} href={r.href} note={r.note} accent={r.accent} doi={'doi' in r ? (r.doi as string) : undefined} tags={'tags' in r ? (r.tags as string[]) : []} />
        ))}
      </div>
    </section>

    <section id="essays" class="rsec">
      <SectionHeading title="Essays" />
      <div class="post-grid">
        {essays.map((c) => (
          <PostCard href={c.href} title={c.title} excerpt={c.excerpt} categoryLabel={c.label} accent={c.accent} image={c.image} imageAlt={c.imageAlt} date={c.date} video={c.video} videoWebm={c.videoWebm} />
        ))}
      </div>
    </section>

    <section id="notes" class="rsec">
      <SectionHeading title="Notes" />
      <div class="post-grid">
        {notes.map((c) => (
          <PostCard href={c.href} title={c.title} excerpt={c.excerpt} categoryLabel={c.label} accent={c.accent} image={c.image} imageAlt={c.imageAlt} date={c.date} video={c.video} videoWebm={c.videoWebm} />
        ))}
      </div>
    </section>

    {experiments.length > 0 && (
    <section id="experiments" class="rsec">
      <SectionHeading title="Experiments" />
      <div class="post-grid">
        {experiments.map((c) => (
          <PostCard href={c.href} title={c.title} excerpt={c.excerpt} categoryLabel={c.label} accent={c.accent} image={c.image} imageAlt={c.imageAlt} date={c.date} video={c.video} videoWebm={c.videoWebm} />
        ))}
      </div>
    </section>
    )}

    <section id="field-notes" class="rsec">
      <SectionHeading title="Field notes" />
      <div class="post-grid">
        {fieldNotes.map((c) => (
          <PostCard href={c.href} title={c.title} excerpt={c.excerpt} categoryLabel="Field note" accent="cream" image={c.image} imageAlt={c.imageAlt} date={c.date} />
        ))}
      </div>
    </section>

    <section id="talks" class="rsec">
      <SectionHeading title="Presentations" />
      <div class="post-grid">
        {talks.map((t) => (
          <ReadingCard title={t.title} authors={t.authors} publisher={t.publisher} year={t.year} href={t.href} note={t.note} accent={t.accent} />
        ))}
      </div>
      <p class="more-link"><a href="https://sarahbarns.com/">More talks and presentations at sarahbarns.com <span aria-hidden="true">&rarr;</span></a></p>
    </section>
  </main>

  <style>
    .reading {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .reading-header {
      max-width: 760px;
      margin-bottom: 2.5rem;
    }

    .eyebrow {
      font-family: var(--heading);
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--purple);
      margin: 0 0 0.5rem;
    }

    h1 {
      font-family: var(--heading);
      font-size: clamp(2rem, 4.5vw, 2.8rem);
      font-weight: var(--w-bold);
      line-height: 1.1;
      margin: 0 0 1rem;
    }

    .standfirst {
      font-family: var(--body);
      font-size: var(--fs-lead);
      font-weight: var(--w-light);
      line-height: 1.6;
      margin: 0;
    }

    /* Jump links to each kind of reading; they stay in reach while scrolling. */
    .rss {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-left: 0.8rem;
      padding: 0.1rem 0.55rem;
      border: 1.5px solid currentColor;
      border-radius: 999px;
      color: var(--terracotta);
      text-decoration: none;
      vertical-align: 1px;
    }
    .rss:hover, .rss:focus-visible { background: var(--terracotta); color: #fff; }

    .tag-filter { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.4rem; }
    .tag-btn {
      appearance: none;
      cursor: pointer;
      font-family: var(--heading);
      font-size: 0.78rem;
      padding: 0.2rem 0.75rem;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      background: #fff;
      color: var(--text);
    }
    .tag-btn[aria-pressed="true"] { background: var(--ink, #1f1d24); color: #fff; }

    .pills {
      position: sticky;
      top: 0;
      z-index: 5;
      margin: 0 0 2.5rem;
      padding: 0.75rem 0;
      background: var(--bg);
    }

    .pills ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .pills a {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.4rem 0.95rem;
      background: #fff;
      border: 2px solid var(--border);
      border-radius: 999px;
      box-shadow: 2px 2px 0 var(--purple);
      font-family: var(--heading);
      font-size: var(--fs-small);
      font-weight: var(--w-medium);
      color: var(--text);
      text-decoration: none;
    }

    .pills a:hover,
    .pills a:focus-visible {
      color: var(--purple);
    }

    .pills .count {
      font-size: 0.75rem;
      color: var(--text-faint);
    }

    .tracker {
      margin: -1.5rem 0 2.75rem;
      font-family: var(--heading);
      font-size: var(--fs-small);
      color: var(--text-dim);
    }

    .tracker-label {
      margin-right: 0.6rem;
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--purple);
    }

    .tracker a,
    .more-link a {
      color: var(--purple);
      font-weight: var(--w-medium);
      text-underline-offset: 3px;
    }

    .more-link {
      margin: 1.4rem 0 0;
      font-family: var(--heading);
      font-size: var(--fs-small);
    }

    .rsec {
      scroll-margin-top: 4.5rem;
    }

    section {
      margin-bottom: clamp(3rem, 6vw, 4.5rem);
    }

    /* Same section pattern as the home page: heading over a thin rule. */
    .reading :global(.section-heading) {
      border: 0;
      border-bottom: 1.5px solid var(--border);
      border-radius: 0;
      padding: 0 0 0.65rem;
      margin-bottom: 1.75rem;
      transition: none;
    }

    .reading :global(.section-heading:hover) {
      transform: none;
      box-shadow: none;
    }

    .reading :global(.section-heading h2) {
      font-size: var(--fs-h2);
      font-weight: var(--w-bold);
      letter-spacing: 0;
    }
  </style>
  <script>
    // Tag filter for the readings: one tag at a time, "All" to reset.
    const btns = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const cards = document.querySelectorAll<HTMLElement>('#publications .reading-card');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const tag = b.dataset.tag ?? '';
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        cards.forEach((c) => {
          const tags = (c.dataset.tags ?? '').split('|');
          c.hidden = !!tag && !tags.includes(tag);
        });
      })
    );
  </script>
</BaseLayout>
