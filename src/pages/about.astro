---
import BaseLayout from '../layouts/BaseLayout.astro';
import { frontmatter as about, compiledContent } from '../data/about.md';

// The About text lives in src/data/about.md, editable in the CMS. Each "## "
// heading there becomes a fold. Two folds get extra parts from here: "Working
// with Civic Interplay" adds the audiences list (from the CMS) and the contact
// button, and "Who's behind it" sets its first paragraph beside the RMIT logo.
// The Projects fold is built here from the four projects.

const html = await compiledContent();
const folds = html
  .split(/(?=<h2[\s>])/)
  .filter((part) => part.startsWith('<h2'))
  .map((part) => {
    const m = part.match(/^<h2[^>]*>([\s\S]*?)<\/h2>([\s\S]*)$/)!;
    return { heading: m[1], plain: m[1].replace(/<[^>]+>/g, '').replace(/&#x27;|&#39;|’/g, "'"), body: m[2].trim() };
  });

const isWorking = (f: { plain: string }) => /^working with/i.test(f.plain);
const isWho = (f: { plain: string }) => /^who/i.test(f.plain);
const splitFirst = (body: string) => {
  const i = body.indexOf('</p>');
  return i < 0 ? [body, ''] : [body.slice(0, i + 4), body.slice(i + 4)];
};
---
<BaseLayout title="About" description={about.description}>

  <article class="about">
    <header class="about-head">
      <p class="eyebrow">About</p>
      <h1>{about.title}</h1>
      {String(about.standfirst ?? '').split(/\n\s*\n/).map((para) => para.trim()).filter(Boolean).map((para) => (
        <p class="standfirst">{para}</p>
      ))}
      {about.question && (
        <div class="q-note q-pair">
          <p class="q-main">{about.question}</p>
        </div>
      )}
      <p class="learn"><a href="/proposition/">Read the proposition <span aria-hidden="true">&rarr;</span></a></p>
    </header>

    <section class="fold">
      <details>
        <summary><h2>Projects</h2></summary>
        <div class="fold-body">
      <ul class="doors filled">
        <li class="fill-purple"><a href="/experiments/side-angle-on-place-flows.html"><span>A new kind of archive</span>Tracing public value: A side angle on a place</a></li>
        <li class="fill-ink"><a href="/sovereignties/"><span>Shared records</span>Data Centres Transparency Project</a></li>
        <li class="fill-plum"><a href="/we-care-rmit/"><span>Place</span>WeCare, City North</a></li>
        <li class="fill-terracotta"><a href="/gathering-intelligences/"><span>Method</span>Gathering Intelligences</a></li>
      </ul>
        </div>
      </details>
    </section>

    {folds.map((f) => (
      <section class="fold">
        <details>
          <summary><h2 set:html={f.heading} /></summary>
          <div class="fold-body md">
            {isWho(f) ? (
              <>
                <div class="lead-person">
                  <div set:html={splitFirst(f.body)[0]} />
                  <img src="/images/partners/rmit-university.png" alt="RMIT University" width="720" height="253" class="rmit" loading="lazy" />
                </div>
                <Fragment set:html={splitFirst(f.body)[1]} />
              </>
            ) : (
              <Fragment set:html={f.body} />
            )}
            {isWorking(f) && (
              <>
                <dl class="stances">
                  {(about.audiences ?? []).map((a: { name: string; text: string; linkLabel?: string; linkHref?: string }) => (
                    <div><dt>{a.name}</dt><dd>{a.text} {a.linkHref && <a href={a.linkHref}>{a.linkLabel || 'More'}</a>}</dd></div>
                  ))}
                </dl>
                <p id="contact">
                  <a class="contact-button" href="https://www.rmit.edu.au/profiles/b/sarah-barns2" data-u="sarah" data-d="studioesem.com" rel="nofollow">Get in touch</a>
                </p>
              </>
            )}
          </div>
        </details>
      </section>
    ))}

  </article>

  <style>
    .about {
      max-width: 760px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    .eyebrow {
      font-family: var(--heading);
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--purple);
      margin: 0 0 0.5rem;
    }

    h1 {
      font-family: var(--heading);
      font-size: clamp(2rem, 4.5vw, 2.8rem);
      font-weight: var(--w-bold);
      line-height: 1.1;
      letter-spacing: 0;
      margin: 0 0 1rem;
    }

    /* The premise, set large: the line the whole practice rests on. */
    .premise-line {
      font-family: var(--body);
      font-style: italic;
      font-weight: var(--w-light);
      font-size: clamp(1.25rem, 2.6vw, 1.55rem);
      line-height: 1.45;
      margin: 0 0 2rem;
      padding-left: 1rem;
      border-left: 3px solid var(--pink);
    }

    /* Everything after Why now folds away, so the page reads as the
       argument first and the detail on request. */
    .fold {
      margin-top: 0;
      padding-top: 0;
    }

    .fold + .fold {
      border-top-width: 1px;
    }

    .fold details > summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.4rem 0 0.4rem;
    }

    .fold details > summary::-webkit-details-marker {
      display: none;
    }

    .fold summary h2 {
      margin: 0;
    }

    .fold summary::after {
      content: '+';
      flex: none;
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 2px solid var(--border);
      border-radius: 50%;
      font-family: var(--heading);
      font-size: 1.2rem;
      font-weight: var(--w-bold);
      line-height: 1;
      color: var(--purple);
      background: #fff;
    }

    .fold details[open] > summary::after {
      content: '\2212';
    }

    .fold summary:focus-visible {
      outline: 3px solid var(--purple);
      outline-offset: 4px;
    }

    .fold-body {
      padding: 0.8rem 0 0.5rem;
    }

    .learn {
      margin: 1.1rem 0 0;
    }

    .learn a {
      font-family: var(--heading);
      font-weight: var(--w-bold);
      font-size: var(--fs-lead);
      color: var(--purple);
      text-underline-offset: 4px;
    }

    .about-head + .fold {
      margin-top: 2.5rem;
    }

    .about-head .q-pair {
      margin: 1.25rem 0 0;
    }

    .standfirst + .standfirst {
      margin-top: 0.9rem;
    }

    .standfirst {
      font-family: var(--body);
      font-size: var(--fs-lead);
      font-weight: var(--w-light);
      line-height: 1.6;
      margin: 0;
    }

    section {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px solid var(--border);
    }

    h2 {
      font-family: var(--heading);
      font-size: var(--fs-h2);
      font-weight: var(--w-bold);
      line-height: 1.2;
      margin: 0 0 1rem;
    }

    p {
      font-family: var(--body);
      font-weight: var(--w-light);
      line-height: 1.7;
      margin: 0 0 1rem;
    }

    p strong {
      font-weight: 700;
    }

    /* Text from about.md arrives as plain HTML, so style it globally here. */
    .md :global(p) {
      font-family: var(--body);
      font-weight: var(--w-light);
      line-height: 1.7;
      margin: 0 0 1rem;
    }
    .md :global(strong) { font-weight: 700; }
    .md :global(a) { color: var(--purple); text-underline-offset: 3px; }
    .md :global(ul), .md :global(ol) { font-family: var(--body); font-weight: var(--w-light); line-height: 1.7; padding-left: 1.2rem; }

    a {
      color: var(--purple);
      text-underline-offset: 3px;
    }

    .more {
      font-family: var(--heading);
      font-size: var(--fs-small);
    }

    .anchors {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }

    .anchors div {
      background: #fff;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 4px 4px 0 var(--card-shadow);
      padding: 1rem 1.1rem;
    }

    .anchors dt {
      font-family: var(--heading);
      font-size: var(--fs-lead);
      font-weight: var(--w-bold);
      color: var(--card-kicker);
      margin-bottom: 0.4rem;
    }

    .anchors dd {
      margin: 0;
      font-family: var(--body);
      font-weight: var(--w-light);
      font-size: var(--fs-small);
      line-height: 1.55;
    }

    .lead-person {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 130px;
      gap: 1.5rem;
      align-items: start;
    }

    .rmit {
      width: 130px;
      height: auto;
      margin-top: 0.3rem;
    }

    .lineage {
      width: 100%;
      border-collapse: collapse;
      margin: 0.5rem 0 1.5rem;
      font-size: var(--fs-small);
    }

    .lineage th {
      text-align: left;
      font-family: var(--heading);
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--text-faint);
      padding: 0 0.8rem 0.5rem 0;
      border-bottom: 2px solid var(--border);
    }

    .lineage td {
      vertical-align: top;
      padding: 0.6rem 0.8rem 0.6rem 0;
      border-bottom: 1px solid var(--border-light);
      font-family: var(--body);
      font-weight: var(--w-light);
      line-height: 1.5;
    }

    .lineage td:first-child {
      font-family: var(--heading);
      font-weight: var(--w-bold);
      white-space: nowrap;
    }

    .lineage td:nth-child(2) {
      font-family: var(--heading);
      font-weight: var(--w-medium);
    }

    .links {
      font-family: var(--heading);
      font-size: var(--fs-small);
    }

    .doors {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .doors a {
      display: block;
      background: #fff;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 4px 4px 0 var(--card-shadow);
      padding: 0.9rem 1.1rem;
      font-family: var(--heading);
      font-weight: var(--w-bold);
      color: var(--text);
      text-decoration: none;
    }

    .doors a span {
      display: block;
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--card-kicker);
      margin-bottom: 0.3rem;
    }

    /* Projects, filled. Deep inks so white text clears AA. */
    /* Brand purple and the drawing-study ink at full strength; pink and
       terracotta one step deeper so white text clears AA (plum 5.3:1,
       terracotta 4.9:1). */
    .filled .fill-purple     { --fill: var(--purple); --ink: var(--ink-purple); }
    .filled .fill-ink        { --fill: #1f1d24; --ink: #1f1d24; }
    .filled .fill-plum       { --fill: var(--pink); --ink: var(--ink-pink); }
    .filled .fill-terracotta { --fill: var(--terracotta); --ink: var(--ink-terracotta); }

    .doors.filled a {
      background: #fff;
      color: var(--text);
      box-shadow: 5px 5px 0 var(--fill);
    }

    .doors.filled a span {
      color: var(--ink);
    }

    .doors.filled a:focus-visible {
      outline: 3px solid var(--pink);
      outline-offset: 3px;
    }

    .contact-button {
      display: inline-block;
      padding: 0.55rem 1.2rem;
      background: var(--purple);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 3px 3px 0 var(--border);
      font-family: var(--heading);
      font-size: var(--fs-small);
      font-weight: var(--w-medium);
      text-decoration: none;
      color: #fff;
    }

    .chain {
      list-style: none;
      margin: 1.5rem 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.4rem;
      counter-reset: none;
    }

    .chain li {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: #fff;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 4px 4px 0 var(--card-shadow);
      padding: 0.9rem 1rem;
    }

    /* The arrow between steps: inquiry leads to literacy, to translation, to agency. */
    .chain li + li::before {
      content: '\2192';
      position: absolute;
      left: -1.25rem;
      top: 0.9rem;
      font-family: var(--heading);
      font-weight: var(--w-bold);
      color: var(--text-faint);
    }

    .c-name {
      font-family: var(--heading);
      font-weight: var(--w-bold);
      color: var(--card-kicker);
    }

    .c-body {
      font-family: var(--body);
      font-weight: var(--w-light);
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .stances {
      margin: 1rem 0;
    }

    .stances div {
      display: grid;
      grid-template-columns: 9rem 1fr;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border-light);
    }

    /* Care is the exception to the three neutralities, so it is set apart. */
    .stances .care {
      margin-top: 0.5rem;
      padding: 0.9rem 1rem;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 4px 4px 0 var(--pink);
      background: #fff;
    }

    .stances .care dt {
      color: var(--ink-pink);
    }

    .stances dt {
      font-family: var(--heading);
      font-weight: var(--w-bold);
    }

    .stances dd {
      margin: 0;
      font-family: var(--body);
      font-weight: var(--w-light);
      line-height: 1.55;
    }

    .invite {
      font-style: italic;
      font-size: var(--fs-lead);
    }

    @media (max-width: 700px) {
      .chain { grid-template-columns: minmax(0, 1fr); }
      .chain li + li::before { content: '\2193'; left: 1rem; top: -1.35rem; }
      .stances div { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
      .anchors,
      .doors { grid-template-columns: minmax(0, 1fr); }
      .lead-person { grid-template-columns: minmax(0, 1fr); }
    }
  </style>

  <script>
    document.querySelectorAll('a.contact-button[data-u]').forEach((a) => {
      a.setAttribute('href', 'mailto:' + a.getAttribute('data-u') + '@' + a.getAttribute('data-d'));
    });
  </script>
</BaseLayout>
