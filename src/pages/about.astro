---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const post = await getEntry('posts', 'what-is-civic-interplay');
if (!post) throw new Error('about: missing what-is-civic-interplay post');

const { Content } = await post.render();
---
<BaseLayout
  title="About"
  description={post.data.excerpt}
  ogImage={post.data.featureImage}
>
  <article>
    <div class="narrow">
      <div class="post-header">
        <div class="post-tag" style="color: var(--purple)">About</div>
        <h1>{post.data.title}</h1>
      </div>

      <div class="post-content">
        <Content />
      </div>

      <section class="about-author" aria-labelledby="about-sarah-heading">
        <h2 id="about-sarah-heading">About Sarah</h2>
        <p>
          Sarah Barns is Vice Chancellor's Senior Research Fellow at <a href="https://www.rmit.edu.au/profiles/b/sarah-barns2">RMIT University</a>, and a co-founder of <a href="https://www.studioesem.com/">Studio ESEM</a> with Michael Killalea, through which she leads <a href="https://storybox.co/">STORYBOX</a>. Her research and practice explores civic agencies, platform urbanism, sensory urban interpretation, and the participatory politics of digital and AI infrastructures. She is the author of <em>Platform Urbanism</em> (Palgrave Macmillan, 2020).
        </p>
        <p>
          Sarah has a long history of media innovation at the intersection of urban-historical change, historical interpretation, digital governance and experience design. Her PhD practice supported the ABC's first mobile content platform and was awarded the ABC's Best Digital Content Award in 2008 (Sydney Sidetracks). Through Studio ESEM, her practice founded in 2011 with Michael Killalea, she has led award-winning digital interpretation projects for the Australian National University (Mt Stromlo Observatory), the Australian Museum (Birds of Australia STORYBOX) and City of Parramatta Council, among others. 
          In 2025 her participatory media platform STORYBOX received the International Award for Participatory Media and Infrastructure at the Media Architecture Biennale.
        </p>
        <p>
          Today Sarah's research weaves practices of participatory storytelling, media architecture and political/environmental geography as agents of change in the creation of civic AI. This research chapter builds on her pioneering work in the shaping of platform urbanism as a field of digital geography (2013-2018) to now consider practices of digital civics as *somewhat playful acts*, reflective of the *somewhat post-rational* nature of the agentic imagination. 
          Her current work, expressed in the form of *civic-interplay* is funded through an RMIT Vice Chancellor's Senior Research Fellowship, and based at the Centre for Urban Research in alliance with the Planetary Civics Inquiry.
        </p>
        <p class="about-author-links" aria-label="Sarah's author identity links">
          <a href="https://sarahbarns.com/">sarahbarns.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://orcid.org/0000-0002-0087-7166" rel="me">ORCID</a>
          <span aria-hidden="true">·</span>
          <a href="https://scholar.google.com/citations?user=cnGxyWQAAAAJ" rel="me">Google Scholar</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/sarahbarns/" rel="me">LinkedIn</a>
        </p>
      </section>

      <div class="back-link">
        <a href="/">Civic Interplay</a>
      </div>
    </div>
  </article>
</BaseLayout>
