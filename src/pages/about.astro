---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { CATEGORY_LABEL } from '../content/config';

const post = await getEntry('posts', 'what-is-civic-interplay');
if (!post) throw new Error('about: missing what-is-civic-interplay post');

const { Content } = await post.render();

// A way in rather than a dead end: the other foundational docs, plus the
// field notes, so someone who has just read what this is can go and use it.
const foundational = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .filter((p) => p.data.primaryCategory === 'foundational-docs')
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((p) => ({
    href: `/${p.slug}/`,
    title: p.data.title,
    excerpt: p.data.excerpt,
    category: p.data.primaryCategory,
    categoryLabel: p.data.primaryCategory ? CATEGORY_LABEL[p.data.primaryCategory] : undefined,
    accent: p.data.accent,
    image: p.data.featureImage,
    imageAlt: p.data.featureImageAlt,
    video: p.data.featureVideo,
    videoWebm: p.data.featureVideoWebm,
  }));

const fieldNotes = (await getCollection('fieldnotes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((n) => ({
    href: `/field-notes/${n.slug}/`,
    title: n.data.title,
    excerpt: n.data.description,
    category: undefined,
    categoryLabel: 'Field note',
    accent: 'periwinkle' as const,
    image: `/images/tiles/${n.data.tileId}-560.webp`,
    imageAlt: n.data.imageAlt,
    video: undefined,
    videoWebm: undefined,
  }));

const diveIn = [...foundational, ...fieldNotes];
---
<BaseLayout
  title="About"
  description={post.data.excerpt}
  ogImage={post.data.featureImage}
>
  <article>
    <div class="narrow">
      <div class="post-header">
        <div class="post-tag" style="color: var(--purple)">About</div>
        <h1>{post.data.title}</h1>
      </div>

      <!-- A plain answer before the cards start. Someone arriving cold, a
           journalist most of all, should get the one-line version before
           scrolling through the card deck. -->
      <div class="about-standfirst">
        <p class="about-standfirst-lead">
          A think and do space for agentic civics and civic AI, which explores
          ideas and practices that look to a future where civic AI governance
          is not only imaginable, but real.
        </p>
      </div>

      <div class="post-content">
        <Content />
      </div>

      <section class="about-author" aria-labelledby="about-sarah-heading">
        <h2 id="about-sarah-heading">About Sarah</h2>
        <p>
          Civic Interplay is a method of practice being experimentally applied
          by Sarah Barns, Vice Chancellor's Senior Research Fellow at RMIT's
          <a href="https://cur.org.au/">Centre for Urban Research</a>.
        </p>
        <p>
          During the 2010s Sarah established platform urbanism, through
          <a href="https://link.springer.com/book/10.1007/978-981-32-9725-8"><em>Platform Urbanism: Negotiating Platform Ecosystems in Connected Cities</em></a>
          (Palgrave Macmillan, 2020), as a field of urban-digital enquiry,
          building on 10 years of policy and practice in technology R&amp;D.
        </p>
        <p>
          Her civic-creative practices <a href="https://www.studioesem.com/">Studio ESEM</a>
          and <a href="https://storybox.co/">STORYBOX Places</a> each work with
          communities and place custodians as co-creators of digital and
          multi-sensory experiences in common. Her personal profile page is
          <a href="https://sarahbarns.com/">sarahbarns.com</a>.
        </p>
        <p>
          <a class="contact-button" href="https://www.rmit.edu.au/profiles/b/sarah-barns2" data-u="sarah" data-d="studioesem.com" rel="nofollow">Contact Sarah</a>
        </p>
        <p class="about-author-links" aria-label="Sarah's author identity links">
          <a href="https://sarahbarns.com/">sarahbarns.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://orcid.org/0000-0002-0087-7166" rel="me">ORCID</a>
          <span aria-hidden="true">·</span>
          <a href="https://scholar.google.com/citations?user=cnGxyWQAAAAJ" rel="me">Google Scholar</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/sarahbarns/" rel="me">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.studioesem.com/" rel="me">Studio ESEM</a>
        </p>
      </section>

    </div>

    {diveIn.length > 0 && (
      <section class="container about-next">
        <SectionHeading title="Dive in" />
        <div class="post-grid">
          {diveIn.map((c) => (
            <PostCard
              href={c.href}
              title={c.title}
              excerpt={c.excerpt}
              category={c.category}
              categoryLabel={c.categoryLabel}
              accent={c.accent}
              image={c.image}
              imageAlt={c.imageAlt}
              video={c.video}
              videoWebm={c.videoWebm}
            />
          ))}
        </div>
      </section>
    )}

    <div class="narrow">
      <div class="back-link">
        <a href="/">Civic Interplay</a>
      </div>
    </div>
  </article>

  <style>
    .about-standfirst {
      margin: 0 0 2.5rem;
      padding-left: 1.2rem;
      border-left: 4px solid var(--purple);
      max-width: 62ch;
    }

    .about-standfirst-lead {
      font-family: var(--body);
      font-size: clamp(1.05rem, 2.2vw, 1.25rem);
      line-height: 1.6;
      color: var(--text);
      margin: 0;
    }

    .about-next {
      margin: 3.5rem auto 0;
      padding-top: 2.5rem;
      border-top: 2px solid var(--border);
    }

    .contact-button {
      display: inline-block;
      padding: 0.55rem 1.2rem;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 3px 3px 0 var(--border);
      font-family: var(--heading);
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
    }
    .contact-button:hover {
      transform: translateY(-2px);
      box-shadow: 5px 5px 0 var(--border);
      color: var(--purple);
    }
    .about-more {
      margin: 2.5rem 0 1.25rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-light);
    }
    .about-more summary {
      cursor: pointer;
      font-family: var(--heading);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--purple);
    }
    .about-more p {
      margin-top: 1rem;
      font-size: 0.9rem;
      font-style: italic;
      color: var(--text-dim);
    }
  </style>

  <script>
    // Assemble the mailto at runtime so the address isn't in the page source (anti-spam).
    document.querySelectorAll('a.contact-button[data-u]').forEach((a) => {
      a.setAttribute('href', 'mailto:' + a.getAttribute('data-u') + '@' + a.getAttribute('data-d'));
    });
  </script>
</BaseLayout>
