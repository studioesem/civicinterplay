---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const post = await getEntry('posts', 'what-is-civic-interplay');
if (!post) throw new Error('about: missing what-is-civic-interplay post');

const { Content } = await post.render();
---
<BaseLayout
  title="About"
  description={post.data.excerpt}
  ogImage={post.data.featureImage}
>
  <article>
    <div class="narrow">
      <div class="post-header">
        <div class="post-tag" style="color: var(--purple)">About</div>
        <h1>{post.data.title}</h1>
      </div>

      <div class="post-content">
        <Content />
      </div>

      <section class="about-author" aria-labelledby="about-sarah-heading">
        <h2 id="about-sarah-heading">About Sarah</h2>
        <p>
          Sarah Barns is a co-founder of <a href="https://www.studioesem.com/">Studio ESEM</a> with Michael Killalea, through which she leads <a href="https://storybox.co/">STORYBOX</a>. Her research today integrates the role of participatory storytelling, public space media and historical interpretation in shaping civic AI architectures, towards a more relational approach to questions of digital sovereignty and governance. This work is funded under an <a href="https://www.rmit.edu.au/profiles/b/sarah-barns2">RMIT Vice Chancellor's Senior Research Fellowship</a>.
        </p>
        <p>
          She is the author of <em>Platform Urbanism</em> (Palgrave Macmillan, 2020). Her PhD practice supported the ABC's first mobile content platform and was awarded the ABC's Best Digital Content Award in 2008 (Sydney Sidetracks).
        </p>
        <p class="about-author-links" aria-label="Sarah's author identity links">
          <a href="https://sarahbarns.com/">sarahbarns.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://orcid.org/0000-0002-0087-7166" rel="me">ORCID</a>
          <span aria-hidden="true">·</span>
          <a href="https://scholar.google.com/citations?user=cnGxyWQAAAAJ" rel="me">Google Scholar</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/sarahbarns/" rel="me">LinkedIn</a>
        </p>
      </section>

      <div class="back-link">
        <a href="/">Civic Interplay</a>
      </div>
    </div>
  </article>
</BaseLayout>
