document.getElementById('beyond').style.left=pct(NOW)+'%';
[2016,2020,2024,2028,2032,2036].forEach(y=>{const s=document.createElement('span');s.style.left=pct(y)+'%';s.textContent=y;ticks.appendChild(s)});
EV.forEach((e,i)=>{const d=document.createElement('div');d.className='ev'+(i%2?' low':'')+(e.minor?' minor':'')+(e.now?' now':'')+(e.y===MAX?' end':'');d.style.left=pct(e.y)+'%';const b=document.createElement('button');b.type='button';b.textContent=e.t;b.addEventListener('click',()=>{input.value=e.y;render()});d.appendChild(b);track.appendChild(d)});
const els=[...document.querySelectorAll('.plate svg [data-y]')];
const nk=document.getElementById('now-k'),nv=document.getElementById('now-v'),ns=document.getElementById('now-s');
function render(){
 const y=+input.value; out.textContent=y;
 els.forEach(el=>{el.classList.toggle('is-off',+el.dataset.y>y); if(el.dataset.end) el.classList.toggle('expired',y>=+el.dataset.end)});
 const ahead=y>NOW; state.textContent=ahead?'What the promises imply':(y===NOW?'The record to date':'The record as it stood'); state.classList.toggle('ahead',ahead);
 if(ahead){nk.textContent='IN '+y+' · WHAT WAS PROMISED';nv.textContent=y>=2030?'5 million trees across Sydney':'Planting toward 2030';ns.textContent='Outlined trees: the promise, not a forecast';}
 else if(y===NOW){nk.textContent='TODAY · ON THE GROUND';nv.textContent='Not yet read';ns.textContent='Canopy, heat and the creek edge: first walk along Mamre Road and South Creek';}
 else{nk.textContent='IN '+y+' · ON THE GROUND';nv.textContent='Record to be gathered';ns.textContent='Canopy and heat by year, from mapping and walks';}
 let ev=null;EV.forEach(e=>{if(e.y<=y)ev=e});
 note.innerHTML=ev?ev.n:before;
}
input.addEventListener('input',render);render();
})();
</script>
</body>
</html>
