---
// The words on this page come from src/content/experiments/side-angle-on-the-western-parkland-city.md,
// editable in the CMS under Experiments. The drawing, its styles and the
// timeline script stay here.
import { getEntry } from 'astro:content';
import ExperimentCrumb from '../../components/ExperimentCrumb.astro';
import ExperimentText from '../../components/ExperimentText.astro';
import { inlineMd } from '../../lib/inline-md';

const e = (await getEntry('experiments', 'side-angle-on-the-western-parkland-city'))!;
const { Content } = await e.render();
const events = e.data.timeline.map((t) => ({
  y: t.year,
  t: t.label,
  n: inlineMd(t.note),
  minor: t.minor ? 1 : 0,
  now: t.label.toLowerCase() === 'today' ? 1 : 0,
}));
const before = inlineMd(e.data.timelineBefore);
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{e.data.title}</title>
<meta name="description" content={e.data.description}>
{e.data.draft && <meta name="robots" content="noindex">}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<style is:global>
/* Layout: one hand-drawn axonometric plate on paper, a timeline, then key, sources and an invitation.
   Treatment: ink line drawing with loose watercolour washes, in the Civic Interplay palette.
   Single paper look by choice: light in both themes. */
*,*::before,*::after{box-sizing:border-box}
:root{color-scheme:light;--paper:#f6f2ea;--sheet:#fbf8f2;--ink:#2a2622;--ink2:#5b544c;--line:#8a8178;--faint:#cfc5b6;
--purple:#7D50BD;--purple-soft:#d9c9ef;--pink:#E076DB;--pink-ink:#B03FAC;--forest:#454E41;--leaf:#7e9a6b;--water:#8E9BDD;--terracotta:#D16D54;--sand:#DACCBA;
--display:"Fira Sans",system-ui,sans-serif;--body:Merriweather,Georgia,serif}
body{margin:0;background:var(--paper);color:var(--ink);font:300 16px/1.7 var(--body)}
.wrap{max-width:1200px;margin:0 auto;padding-block:2.5rem 3rem;padding-inline:max(16px,3vw)}
.eyebrow{font:500 .75rem var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--purple);margin:0 0 .4rem}
h1{font:700 clamp(1.8rem,4.5vw,2.8rem)/1.1 var(--display);margin:0 0 .8rem;text-wrap:balance}
.lede,.intro>p{max-width:64ch;margin:0 0 1.6rem}
.plate{margin:0;background:var(--sheet);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--purple);overflow-x:auto;position:relative}
.plate svg{display:block;width:100%;min-width:780px;height:auto}
.platebar{display:flex;justify-content:space-between;gap:.4rem 1rem;flex-wrap:wrap;font:400 .72rem var(--display);letter-spacing:.06em;text-transform:uppercase;color:var(--line);padding:.6rem 1rem;border-top:1px solid var(--faint)}
/* svg drawing */
svg .wash{filter:url(#wash);mix-blend-mode:multiply}
svg .plane{fill:var(--sheet);fill-opacity:.55;stroke:none}
svg .ink,svg .ink-line{fill:none;stroke:var(--ink);stroke-width:1.3;filter:url(#sketch)}
svg .edge{fill:none;stroke:var(--ink);stroke-width:1.3;filter:url(#sketch)}
svg .sheet-old{fill:none;stroke:var(--ink2);stroke-width:1;stroke-dasharray:7 5;filter:url(#sketch)}
svg .inst-name{font:500 11px var(--display);letter-spacing:.06em;fill:var(--ink2)}
svg .inst-end{font:italic 300 10.5px var(--body);fill:var(--line)}
svg .inst.expired{opacity:.35}
svg .inst.expired .sheet-old{stroke-dasharray:2 7}
svg .lot{fill:none;stroke:var(--ink2);stroke-width:.8;filter:url(#sketch)}
svg .shed{fill:url(#hatch-ground);stroke:var(--ink);stroke-width:1;filter:url(#sketch)}
svg .heat{fill:var(--terracotta);opacity:.18}
svg .road{stroke:var(--ink2);stroke-width:1.2;stroke-dasharray:10 6;filter:url(#sketch)}
svg .creek-wash{fill:none;stroke:var(--water);stroke-width:14;stroke-linecap:round;stroke-linejoin:round;opacity:.55}
svg .creek-ink{fill:none;stroke:#3d4a8a;stroke-width:1.2;filter:url(#sketch)}
svg .tree{fill:var(--leaf);opacity:.6}
svg .tree-future{fill:none;stroke:var(--leaf);stroke-width:1.1;stroke-dasharray:2 2}
svg .permit{fill:url(#hatch-purple);stroke:var(--purple);stroke-width:1.3;filter:url(#sketch)}
svg .permit-top{fill:var(--purple-soft);stroke:var(--purple);stroke-width:1.3;filter:url(#sketch)}
svg .spend{fill:var(--purple)}
svg .corridor{fill:none;stroke:var(--leaf);stroke-width:62;stroke-linecap:round;stroke-linejoin:round;opacity:.42}
svg .corridor-ink{fill:none;stroke:var(--forest);stroke-width:1;stroke-dasharray:3 5;filter:url(#sketch)}
svg .heatval{fill:var(--pink);opacity:.16}
svg .heatval-ink{fill:none;stroke:var(--pink);stroke-width:1.3;filter:url(#sketch)}
svg .empty{fill:none;stroke:var(--ink);stroke-width:1.4;stroke-dasharray:8 6;filter:url(#sketch)}
svg .empty-lbl{font:italic 400 13px var(--body);fill:var(--ink2)}
svg .empty-sm{font:italic 300 10.5px var(--body);fill:var(--line)}
svg .layer{font:700 13px var(--display);letter-spacing:.16em;fill:var(--ink)}
svg .cap{font:300 12px var(--body);fill:var(--line)}
svg .tiny{font:400 10.5px var(--display);fill:var(--ink2);letter-spacing:.04em}
svg .vsub{font:500 13.5px var(--display);fill:var(--pink-ink);paint-order:stroke;stroke:var(--sheet);stroke-width:5px;stroke-linejoin:round}
svg .vsub-g{font:500 13.5px var(--display);fill:var(--forest);paint-order:stroke;stroke:var(--sheet);stroke-width:5px;stroke-linejoin:round}
svg .plumb{stroke:var(--ink);stroke-width:1}
svg .gapline{stroke:var(--purple);stroke-width:1.5;stroke-dasharray:4 4}
svg .faint{stroke:var(--line);stroke-width:1;stroke-dasharray:2 4}
svg .node{fill:var(--ink)}
svg .node-open{fill:var(--sheet);stroke:var(--purple);stroke-width:1.6}
svg .q{font:700 22px var(--display);fill:var(--purple)}
svg .q-sm{font:italic 400 12px var(--body);fill:var(--purple)}
svg .lead{stroke:var(--purple);stroke-width:1}
svg .badge{fill:var(--purple)}
svg .badge-t{font:700 12px var(--display);fill:#fff}
svg .hl-k{font:500 11px var(--display);letter-spacing:.14em;fill:var(--line)}
svg .hl-v{font:700 38px var(--display);fill:var(--ink);paint-order:stroke;stroke:var(--sheet);stroke-width:6px;stroke-linejoin:round}
svg .hl-s{font:400 15px var(--display);fill:var(--ink2)}
svg .now-v{font:700 28px var(--display);fill:var(--forest)}
svg .now-s{font:400 13px var(--body);fill:var(--line)}
svg .areawide{fill:url(#hatch-pink);opacity:.55}
svg .aw-swatch{fill:url(#hatch-pink);stroke:var(--pink);stroke-width:.8}
svg .aw-h{font:500 10.5px var(--display);letter-spacing:.12em;fill:var(--pink-ink)}
svg .aw-t{font:500 13px var(--display);fill:var(--ink)}
svg .aw-s{font:300 10.5px var(--body);fill:var(--line)}
svg .aw-n{font:italic 300 10.5px var(--body);fill:var(--line)}
svg .country{fill:none;stroke:var(--ink2);stroke-width:1.2;stroke-dasharray:10 7;filter:url(#sketch)}
svg .country-lbl{font:italic 400 12px var(--body);fill:var(--ink2)}
svg a.badge-link{cursor:pointer}
svg a.badge-link:hover .badge,svg a.badge-link:focus .badge{fill:var(--ink)}
.stations{display:grid;gap:1rem;margin-top:1rem}
.station{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.4rem 1rem;background:var(--sheet);border:1.5px solid var(--ink);padding:1.1rem 1.2rem;scroll-margin-top:1rem}
.station:target{box-shadow:5px 5px 0 var(--purple)}
.station .n{grid-row:span 3;margin-top:.15rem}
.station h3{font:700 1.05rem var(--display);margin:0}
.station dl{display:grid;grid-template-columns:7.5rem minmax(0,1fr);gap:.25rem .8rem;margin:.2rem 0 0;font-size:.9rem}
.station dt{font:500 .7rem var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--line);padding-top:.2rem}
.station dd{margin:0}
.station .back{font:500 .78rem var(--display);color:var(--purple)}
@media (max-width:560px){.station dl{grid-template-columns:1fr}.station dt{padding-top:.5rem}}
svg [data-y]{transition:opacity .35s ease}
svg .is-off{opacity:0}
.paper{pointer-events:none}
/* timeline */
.when{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:1.6rem 0 .4rem}
.when output{font:700 clamp(2.2rem,6vw,3.4rem)/1 var(--display);font-variant-numeric:tabular-nums}
.when .state{font:500 .8rem var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--line)}
.when .state.ahead{color:var(--purple)}
.track{position:relative;padding-top:3.6rem}
.track input{width:100%;margin:0;accent-color:var(--purple);height:1.6rem;cursor:pointer}
.ticks{position:relative;height:1.4rem;font:400 .7rem var(--display);color:var(--line);font-variant-numeric:tabular-nums}
.ticks span{position:absolute;transform:translateX(-50%)}
.beyond{position:absolute;top:3.6rem;height:1.6rem;right:0;background:repeating-linear-gradient(135deg,transparent 0 5px,var(--faint) 5px 6px);opacity:.7;pointer-events:none;border-left:2px solid var(--purple)}
.ev{position:absolute;top:0;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px}
.ev.low{top:1.5rem}.ev.end{transform:translateX(-100%);align-items:flex-end}.ev.start{transform:none;align-items:flex-start}
.ev button{font:500 .68rem var(--display);letter-spacing:.04em;background:var(--sheet);color:var(--ink);border:1px solid var(--faint);padding:2px 6px;cursor:pointer;white-space:nowrap}
.ev button:hover,.ev button:focus-visible{border-color:var(--purple);outline:none;color:var(--purple)}
.ev.now button{border-color:var(--purple);color:var(--purple)}
.ev::after{content:"";width:1px;background:var(--line)}.ev:not(.low)::after{height:2.1rem}.ev.low::after{height:.6rem}
.evnote{min-height:3.4em;margin:.8rem 0 0;max-width:72ch;font-size:.95rem}
.evnote b{font-family:var(--display);font-weight:500}
@media (max-width:640px){.ev.minor{display:none}}
/* key */
.key{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1.4rem;margin-top:2.2rem}
.key div{min-width:0}
.key h2{font:500 1.02rem var(--display);margin:0 0 .3rem;display:flex;align-items:center;gap:.55rem}
.n{display:inline-grid;place-items:center;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--purple);color:#fff;font:700 .8rem var(--display);flex:none}
.key p{margin:0;font-size:.9rem}
.sec-h{font:700 .8rem var(--display);letter-spacing:.14em;text-transform:uppercase;margin:3rem 0 0}
.layers{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:.8rem;border-top:1.5px solid var(--ink);padding-top:1.2rem}
.layers>div{min-width:0}.layers h3{font:700 .78rem var(--display);letter-spacing:.14em;text-transform:uppercase;margin:0 0 .5rem}
.layers ul{list-style:none;margin:0;padding:0;display:grid;gap:.5rem;font-size:.88rem}
.layers li{padding-left:1rem;position:relative}.layers li::before{content:"";position:absolute;left:0;top:.75em;width:.45rem;height:1px;background:var(--line)}
.layers a{color:var(--ink)}
.walk{margin-top:2.6rem;padding:1.6rem 1.6rem 1.8rem;background:var(--sheet);border:1.5px solid var(--forest);box-shadow:5px 5px 0 var(--forest);display:grid;gap:.6rem;max-width:760px}
.walk h2{font:700 .8rem var(--display);letter-spacing:.14em;text-transform:uppercase;margin:0;color:var(--forest)}
.walk p{margin:0}.walk .big{font:700 clamp(1.4rem,3.4vw,2rem)/1.2 var(--display);text-wrap:balance}
.walk .share{display:inline-block;font:500 .9rem var(--display);color:#fff;background:var(--forest);padding:.55rem 1rem;text-decoration:none}
.walk .share:hover,.walk .share:focus-visible{background:var(--ink);outline:none}
.note{margin-top:2rem;font-size:.85rem;color:var(--line);max-width:72ch}
@media (prefers-reduced-motion:no-preference){.plate svg .gapline{animation:dash 6s linear infinite}@keyframes dash{to{stroke-dashoffset:-48}}}
</style>
</head>
<body>
<div class="wrap">
<ExperimentCrumb />
<p class="eyebrow">{e.data.eyebrow}</p>
<h1>{e.data.title}</h1>
<div class="intro"><Content /></div>
<figure class="plate" id="top-plate">
<svg viewBox="120 -60 1180 1110" role="img" aria-label="Hand-drawn isometric drawing of a Western Sydney precinct pulled apart into three layers: value with a creek corridor and heat strategy, flows with data centre approvals, and the ground with the creek, sheds and patchy trees. Faded sheets behind the top layer are the institutions that held the promise.">
<defs>
<filter id="sketch" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G"/></filter>
<filter id="wash" x="-15%" y="-15%" width="130%" height="130%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="9" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G" result="d"/><feGaussianBlur in="d" stdDeviation="1.6"/></filter>
<filter id="grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="2" result="t"/><feColorMatrix in="t" type="matrix" values="0 0 0 0 0.45  0 0 0 0 0.38  0 0 0 0 0.3  0 0 0 0.09 0"/></filter>
<pattern id="hatch-purple" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)"><rect width="6" height="6" fill="#efe6f8"/><line x1="0" y1="0" x2="0" y2="6" stroke="#7D50BD" stroke-width="0.9" opacity=".7"/></pattern>
<pattern id="hatch-pink" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="7" stroke="#E076DB" stroke-width="1" opacity=".5"/></pattern><pattern id="hatch-ground" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><rect width="7" height="7" fill="#efe8dc"/><line x1="0" y1="0" x2="0" y2="7" stroke="#8a8178" stroke-width="0.6" opacity=".6"/></pattern>
</defs>
