<section class="scrub" aria-label="Timeline">
<div class="when"><output id="yr" for="year">2026</output><span class="state" id="state">The record to date</span></div>
<div class="track" id="track">
<div class="beyond" id="beyond" aria-hidden="true"></div>
<input type="range" id="year" min="2010" max="2040" step="1" value="2026" aria-label="Year">
</div>
<div class="ticks" id="ticks" aria-hidden="true"></div>
<p class="evnote" id="evnote"></p>
</section>
<ExperimentText data={e.data} />
</div>
<script is:inline define:vars={{ events, before }}>
(function(){
const EV=events;
const NOW=2026, MIN=2010, MAX=2040;
const input=document.getElementById('year'), out=document.getElementById('yr'), state=document.getElementById('state'),
 note=document.getElementById('evnote'), plate=document.querySelector('.plate'), track=document.getElementById('track'), ticks=document.getElementById('ticks');
const pct=y=>((y-MIN)/(MAX-MIN))*100;
document.getElementById('beyond').style.left=pct(NOW)+'%';
[2010,2015,2020,2025,2030,2035,2040].forEach(y=>{const s=document.createElement('span');s.style.left=pct(y)+'%';s.textContent=y;ticks.appendChild(s)});
EV.forEach((e,i)=>{const d=document.createElement('div');d.className='ev'+(i%2?' low':'')+(e.minor?' minor':'')+(e.now?' now':'')+(e.y===MAX?' end':'');d.style.left=pct(e.y)+'%';
 const b=document.createElement('button');b.type='button';b.textContent=e.t;b.addEventListener('click',()=>{input.value=e.y;render()});d.appendChild(b);track.appendChild(d)});
const els=[...document.querySelectorAll('.plate svg [data-y]')];
function render(){
 const y=+input.value; out.textContent=y;
 els.forEach(el=>{const v=+el.dataset.y; el.classList.toggle('is-off', v>y)});
 const ahead=y>NOW; plate.classList.toggle('ahead',ahead);
 state.textContent= ahead?'Projection: what the target implies': (y===NOW?'The record to date':'The record as it stood');
 state.classList.toggle('ahead',ahead);
 const nk=document.getElementById('now-k'), nv=document.getElementById('now-v'), ns=document.getElementById('now-s');
 const meas=t=> t<=2012?22: 22+(t-2012)*(5/14);
 if(!ahead){const c=Math.round(meas(y)); nk.textContent=(y===NOW?'NOW':'IN '+y)+' · ON THE GROUND'; nv.textContent=c+'% canopy'; ns.textContent=(40-c)+' points short of the target';}
 else {const need=Math.round(27+(y-NOW)*(13/14)); nk.textContent='IN '+y+' · NEEDED TO STAY ON TRACK'; nv.textContent=need+'% canopy'; ns.textContent='today 27%, so about one point a year from here';}
 let ev=null; EV.forEach(e=>{if(e.y<=y) ev=e}); 
 note.innerHTML= ev? ev.n : before;
}
input.addEventListener('input',render); render();
})();
</script>
