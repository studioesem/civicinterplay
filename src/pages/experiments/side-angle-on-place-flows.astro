---
// The words on this page come from src/content/experiments/side-angle-on-place-flows.md,
// editable in the CMS under Experiments. The drawing, its styles and the
// timeline script stay here.
import { getEntry } from 'astro:content';
import ExperimentCrumb from '../../components/ExperimentCrumb.astro';
import ExperimentText from '../../components/ExperimentText.astro';
import { inlineMd } from '../../lib/inline-md';

const e = (await getEntry('experiments', 'side-angle-on-place-flows'))!;
const { Content } = await e.render();
const events = e.data.timeline.map((t) => ({
  y: t.year,
  t: t.label,
  n: inlineMd(t.note),
  minor: t.minor ? 1 : 0,
  now: t.label.toLowerCase() === 'today' ? 1 : 0,
}));
const before = inlineMd(e.data.timelineBefore);
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{e.data.title}</title>
<meta name="description" content={e.data.description}>
{e.data.draft && <meta name="robots" content="noindex">}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<style is:global>
*,*::before,*::after{box-sizing:border-box}img{max-width:100%}

/* Layout: a drawing sheet. One axonometric plate, a timeline, then key, sources and invitation. Civic Interplay palette: purple marks what was permitted or paid for, pink the co-designed value, forest the canopy. */
:root{--paper:#f8f8f8;--sheet:#ffffff;--ink:#1f1d24;--line:#6f6a76;--faint:#DACCBA;--block:#efe9e1;--tree:#6f7d66;--permit:#7D50BD;--permit-soft:#F8DFF6;--plum:#E076DB;--plum-ink:#B03FAC;--forest:#454E41;
--display:"Fira Sans",system-ui,sans-serif;--body:Merriweather,Georgia,serif}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--paper:#17151b;--sheet:#211e27;--ink:#ece8f2;--line:#9a94a3;--faint:#4a4250;--block:#2b2731;--tree:#8fa082;--permit:#b48ef0;--permit-soft:#3a2850;--plum:#ec8fe7;--plum-ink:#ec8fe7;--forest:#8fa082;color-scheme:dark}}
:root[data-theme="dark"]{--paper:#17151b;--sheet:#211e27;--ink:#ece8f2;--line:#9a94a3;--faint:#4a4250;--block:#2b2731;--tree:#8fa082;--permit:#b48ef0;--permit-soft:#3a2850;--plum:#ec8fe7;--plum-ink:#ec8fe7;--forest:#8fa082;color-scheme:dark}
body{background:var(--paper);color:var(--ink);font:300 16px/1.7 var(--body);margin:0}
.wrap{max-width:1180px;margin:0 auto;padding-block:2.5rem 3rem;padding-inline:max(16px,3vw)}
.eyebrow{font:500 .75rem var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--permit);margin:0 0 .4rem}
h1{font:700 clamp(1.8rem,4.5vw,2.8rem)/1.1 var(--display);margin:0 0 .8rem;text-wrap:balance}
.lede,.intro>p{max-width:62ch;margin:0 0 1.6rem}
.intro{margin-bottom:2.8rem}.intro>p:last-child{margin-bottom:0}
.plate{background:var(--sheet);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--permit);overflow-x:auto}
.plate svg{display:block;width:100%;min-width:760px;height:auto}
.platebar{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font:400 .75rem var(--display);letter-spacing:.06em;text-transform:uppercase;color:var(--line);padding:.6rem 1rem;border-top:1px solid var(--faint)}
.key{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:2rem}
.key div{min-width:0}
.key h2{font:500 1.05rem var(--display);margin:0 0 .3rem;display:flex;align-items:center;gap:.6rem}
.n{display:inline-grid;place-items:center;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--permit);color:var(--sheet);font:700 .8rem var(--display);flex:none}
.key p{margin:0;font-size:.92rem}
.key em{font-style:italic}
.note{margin-top:2rem;font-size:.85rem;color:var(--line);max-width:70ch}
svg .plane{fill:var(--sheet);stroke:var(--ink);stroke-width:1.2;fill-opacity:.6}
svg .sheet-old{fill:none;stroke:var(--line);stroke-width:1;stroke-dasharray:6 5}
svg .yr{font:500 11px var(--display);fill:var(--line);letter-spacing:.08em}
svg .block{fill:var(--block);stroke:var(--faint);stroke-width:.8}
svg .tree{fill:var(--tree);opacity:.85}
svg .permit{fill:var(--permit-soft);stroke:var(--permit);stroke-width:1.2}
svg .permit-top{fill:var(--permit)}
svg .grid{stroke:var(--permit);stroke-width:.5;opacity:.7}
svg .spend{fill:var(--permit)}
svg .designated{fill:none;stroke:var(--ink);stroke-width:1.2;stroke-dasharray:2 4}
svg .codesigned{fill:var(--plum);fill-opacity:.12;stroke:var(--plum);stroke-width:1.4}
svg .empty{fill:none;stroke:var(--ink);stroke-width:1.4;stroke-dasharray:8 6}
svg .empty-lbl{font:italic 300 12px var(--body);fill:var(--line)}
svg .layer{font:700 13px var(--display);letter-spacing:.14em;fill:var(--ink)}
svg .cap{font:300 12px var(--body);fill:var(--line)}
svg .vhead{font:700 20px var(--display);fill:var(--ink);paint-order:stroke;stroke:var(--sheet);stroke-width:5px;stroke-linejoin:round}svg .vsub{font:500 15px var(--display);fill:var(--plum-ink);paint-order:stroke;stroke:var(--sheet);stroke-width:5px;stroke-linejoin:round}svg .vkind{font-size:11px;font-weight:500;letter-spacing:.14em;fill:var(--line)}svg .vlbl{font:400 12px var(--display);fill:var(--ink)}
svg .plumb{stroke:var(--ink);stroke-width:1}
svg .gapline{stroke:var(--permit);stroke-width:1.4;stroke-dasharray:4 4}
svg .faint{stroke:var(--line);stroke-width:1;stroke-dasharray:2 4}
svg .node{fill:var(--ink)}
svg .node-open{fill:var(--sheet);stroke:var(--permit);stroke-width:1.6}
svg .q{font:700 22px var(--display);fill:var(--permit)}
svg .lead{stroke:var(--permit);stroke-width:1}
svg .badge{fill:var(--permit)}
svg .badge-t{font:700 12px var(--display);fill:var(--sheet)}
@media (prefers-reduced-motion:no-preference){.plate svg .gapline{animation:dash 6s linear infinite}@keyframes dash{to{stroke-dashoffset:-48}}}

svg [data-y]{transition:opacity .35s ease}
svg .is-off{opacity:0}
svg .future{fill:none;stroke:var(--tree);stroke-width:1;stroke-dasharray:2 2}
.plate.ahead svg .plane.flowp,.plate.ahead svg .permit{opacity:.55}
.when{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:1.6rem 0 .4rem}
.when output{font:700 clamp(2.2rem,6vw,3.4rem)/1 var(--display);font-variant-numeric:tabular-nums}
.when .state{font:500 .8rem var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--line)}
.when .state.ahead{color:var(--plum)}
.track{position:relative;padding-top:3.6rem}
.track input{width:100%;margin:0;accent-color:var(--permit);height:1.6rem;cursor:pointer}
.ticks{position:relative;height:1.4rem;font:400 .7rem var(--display);color:var(--line);font-variant-numeric:tabular-nums}
.ticks span{position:absolute;transform:translateX(-50%)}
.beyond{position:absolute;top:3.6rem;height:1.6rem;right:0;background:repeating-linear-gradient(135deg,transparent 0 5px,var(--faint) 5px 6px);opacity:.6;pointer-events:none;border-left:2px solid var(--plum)}
.ev{position:absolute;top:0;}.ev.low{top:1.5rem}.ev.end{transform:translateX(-100%);align-items:flex-end}.ev{transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px}
.ev button{font:500 .68rem var(--display);letter-spacing:.04em;background:var(--sheet);color:var(--ink);border:1px solid var(--faint);padding:2px 6px;cursor:pointer;white-space:nowrap}
.ev button:hover,.ev button:focus-visible{border-color:var(--permit);outline:none;color:var(--permit)}
.ev.now button{border-color:var(--plum);color:var(--plum)}
.ev::after{content:"";width:1px;height:.6rem;background:var(--line)}.ev.low::after{height:.6rem}.ev:not(.low)::after{height:2.1rem}
.evnote{min-height:3.4em;margin:.8rem 0 0;max-width:70ch;font-size:.95rem}
.evnote b{font-family:var(--display);font-weight:500}
@media (max-width:640px){.ev.minor{display:none}}

svg .hl-k{font:500 11px var(--display);letter-spacing:.14em;fill:var(--line)}
svg .hl-v{font:700 34px var(--display);fill:var(--ink);paint-order:stroke;stroke:var(--sheet);stroke-width:6px;stroke-linejoin:round}
svg .now-v{font:700 30px var(--display);fill:var(--tree)}
svg .now-s{font:400 13px var(--body);fill:var(--line)}
.layers{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin-top:2.6rem;border-top:1.5px solid var(--ink);padding-top:1.4rem}
.layers>div{min-width:0}
.layers h2,.layers h3,.walk h2,.sec-h{font:700 .8rem var(--display);letter-spacing:.14em;text-transform:uppercase;margin:0 0 .5rem}
.sec-h{margin-top:3rem}
.layers ul{list-style:none;margin:0;padding:0;display:grid;gap:.45rem;font-size:.9rem}
.layers li{padding-left:1rem;position:relative}
.layers li::before{content:"";position:absolute;left:0;top:.7em;width:.45rem;height:1px;background:var(--line)}
.layers .kind{font:500 .68rem var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--line);display:block}
.layers a{color:var(--ink)}
.walk{margin-top:2.6rem;padding:1.6rem 1.6rem 1.8rem;background:var(--sheet);border:1.5px solid var(--forest);box-shadow:5px 5px 0 var(--forest);display:grid;gap:.6rem;max-width:760px}
.walk h2{color:var(--forest)}
.walk p{margin:0}
.walk .share{display:inline-block;font:500 .9rem var(--display);color:var(--sheet);background:var(--forest);padding:.55rem 1rem;text-decoration:none}.walk .share:hover,.walk .share:focus-visible{background:var(--ink);outline:none}.walk .big{font:700 clamp(1.4rem,3.4vw,2rem)/1.2 var(--display);text-wrap:balance}
.howto ul{margin:.6rem 0 0;padding-left:1.1rem;display:grid;gap:.35rem}.howto li{max-width:70ch}
</style>
</head>
