---
import { getCollection, type CollectionEntry } from 'astro:content';
import VideoEmbed from '../../components/VideoEmbed.astro';
import AudioEmbed from '../../components/AudioEmbed.astro';
import '../../styles/fonts.ts';

export async function getStaticPaths() {
  const items = await getCollection('embeds');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'embeds'>;
}

const { item } = Astro.props;
const d = item.data;
const watchHref = d.sourcePostSlug
  ? `https://civicinterplay.io/${d.sourcePostSlug}/`
  : 'https://civicinterplay.io/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{d.title} - Civic Interplay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <style is:global>
    :root {
      --bg: #f8f8f8;
      --text: #1c1917;
      --text-dim: rgba(28, 25, 23, 0.78);
      --text-faint: rgba(28, 25, 23, 0.55);
      --border: #333;
      --border-light: rgba(28, 25, 23, 0.1);
      --purple: #7D50BD;
      --pink: #E076DB;
      --heading: 'Fira Sans', system-ui, sans-serif;
      --body: 'Fira Sans', system-ui, sans-serif;
      --radius: 12px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: transparent;
      font-family: var(--heading);
      color: var(--text);
    }
    .embed-shell {
      /* small inset so the offset box-shadow on the player isn't clipped by the
         iframe edge; the auto-height script measures this padding too */
      padding: 2px 6px 6px 2px;
      margin: 0;
      position: relative;
    }
    .embed-shell .video-embed {
      margin: 0;
    }
    .embed-watch-link {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.7rem;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
      color: #fff;
      font-family: var(--heading);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 999px;
      transition: background 0.2s ease;
    }
    .embed-watch-link:hover { background: var(--purple); }
    .embed-watch-link::after { content: '\\2197'; font-size: 0.78rem; line-height: 1; }
  </style>
</head>
<body>
  <div class="embed-shell" id="embed-shell">
    <a class="embed-watch-link" href={watchHref} target="_top" rel="noopener">
      {d.mediaType === 'audio' ? 'Listen on Civic Interplay' : 'Watch on Civic Interplay'}
    </a>
    {d.mediaType === 'audio' ? (
      <AudioEmbed
        src={d.audio ?? ''}
        ogg={d.audioOgg}
        poster={d.poster}
        posterAlt={d.title}
        caption={d.caption}
        title={d.title}
      />
    ) : (
      <VideoEmbed
        src={d.video ?? ''}
        webm={d.videoWebm}
        poster={d.poster}
        caption={d.caption}
        aspectRatio={d.aspectRatio ?? '16/9'}
        title={d.title}
      />
    )}
  </div>
  <script>
    // Report our rendered height to the parent page so a host iframe can size
    // itself to the content. This keeps any aspect ratio (16/9, square, audio)
    // from letterboxing or clipping the caption, at any iframe width.
    // The host opts in with the small listener shown in EDITOR-GUIDE.md; without
    // it, the iframe just keeps its authored height (graceful fallback).
    const shell = document.getElementById('embed-shell');
    if (shell) {
      const postHeight = () => {
        const height = Math.ceil(shell.getBoundingClientRect().height);
        parent.postMessage({ type: 'civicinterplay:embed-size', height }, '*');
      };
      window.addEventListener('load', postHeight);
      if ('ResizeObserver' in window) {
        new ResizeObserver(postHeight).observe(shell);
      } else {
        window.addEventListener('resize', postHeight);
      }
    }
  </script>
</body>
</html>
