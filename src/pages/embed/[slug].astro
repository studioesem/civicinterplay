---
import { getCollection, type CollectionEntry } from 'astro:content';
import VideoEmbed from '../../components/VideoEmbed.astro';
import AudioEmbed from '../../components/AudioEmbed.astro';
import '../../styles/fonts.ts';

export async function getStaticPaths() {
  const items = await getCollection('embeds');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'embeds'>;
}

const { item } = Astro.props;
const d = item.data;
// Top right: "Go to story" when the clip belongs to a post (otherwise a plain
// link home), and "Embed", which opens the iframe code to copy.
const storyHref = d.sourcePostSlug ? `https://civicinterplay.io/${d.sourcePostSlug}/` : null;
const watchHref = storyHref ?? 'https://civicinterplay.io/';
const watchLabel = storyHref ? 'Go to story' : d.mediaType === 'audio' ? 'Listen on Civic Interplay' : 'Watch on Civic Interplay';
const ratio = d.mediaType === 'audio' ? null : /^\d+(\.\d+)?\s*\/\s*\d+(\.\d+)?$/.test(d.aspectRatio ?? '') ? d.aspectRatio : '16/9';
const embedCode = `<iframe src="https://civicinterplay.io/embed/${item.id}" title="${d.title.replace(/"/g, '&quot;')}" style="width:100%; border:0;${ratio ? ` aspect-ratio:${ratio};` : ' height:220px;'}" loading="lazy" allowfullscreen></iframe>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{d.title} - Civic Interplay</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <style is:global>
    :root {
      --bg: #f8f8f8;
      --text: #1c1917;
      --text-dim: rgba(28, 25, 23, 0.78);
      --text-faint: rgba(28, 25, 23, 0.55);
      --border: #333;
      --border-light: rgba(28, 25, 23, 0.1);
      --purple: #7D50BD;
      --pink: #E076DB;
      --heading: 'Fira Sans', system-ui, sans-serif;
      --body: 'Fira Sans', system-ui, sans-serif;
      --radius: 12px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: transparent;
      font-family: var(--heading);
      color: var(--text);
    }
    .embed-shell {
      /* small inset so the offset box-shadow on the player isn't clipped by the
         iframe edge; the auto-height script measures this padding too */
      padding: 2px 6px 6px 2px;
      margin: 0;
      position: relative;
    }
    .embed-shell .video-embed {
      margin: 0;
    }
    .embed-actions {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 2;
      display: flex;
      gap: 0.4rem;
    }
    .embed-pill {
      appearance: none;
      border: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.7rem;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
      color: #fff;
      font-family: var(--heading);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 999px;
      transition: background 0.2s ease;
    }
    .embed-pill:hover, .embed-pill:focus-visible, .embed-pill[aria-expanded="true"] { background: var(--purple); }
    .embed-watch-link::after { content: '\2197'; font-size: 0.78rem; line-height: 1; }
    .embed-code {
      position: absolute;
      top: 3rem;
      right: 0.75rem;
      z-index: 3;
      width: min(420px, calc(100% - 2rem));
      padding: 0.8rem 0.9rem;
      background: #fff;
      border: 2px solid var(--border);
      border-radius: 10px;
      box-shadow: 4px 4px 0 var(--purple);
    }
    .embed-code[hidden] { display: none; }
    .embed-code p { margin: 0 0 0.5rem; font-size: 0.8rem; font-weight: 600; }
    .embed-code textarea {
      width: 100%;
      resize: none;
      font: 0.72rem/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
      padding: 0.5rem;
      border: 1px solid var(--border-light);
      border-radius: 6px;
      background: #f8f8f8;
      color: var(--text);
    }
    .embed-code-actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
    .embed-code-actions button {
      appearance: none;
      cursor: pointer;
      font: 600 0.75rem var(--heading);
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      border: 1.5px solid var(--border);
      background: #fff;
      color: var(--text);
    }
    .embed-code-actions .embed-copy { background: var(--purple); border-color: var(--purple); color: #fff; }
  </style>
</head>
<body>
  <div class="embed-shell" id="embed-shell">
    <div class="embed-actions">
      <a class="embed-pill embed-watch-link" href={watchHref} target="_top" rel="noopener">{watchLabel}</a>
      <button type="button" class="embed-pill embed-code-toggle" aria-expanded="false" aria-controls="embed-code">Embed <span aria-hidden="true">&lt;/&gt;</span></button>
    </div>
    <div class="embed-code" id="embed-code" hidden>
      <p>Embed this on your site</p>
      <textarea readonly rows="3" aria-label="Embed code">{embedCode}</textarea>
      <div class="embed-code-actions">
        <button type="button" class="embed-copy">Copy code</button>
        <button type="button" class="embed-close">Close</button>
      </div>
    </div>
    {d.mediaType === 'audio' ? (
      <AudioEmbed
        src={d.audio ?? ''}
        ogg={d.audioOgg}
        poster={d.poster}
        posterAlt={d.title}
        caption={d.caption}
        title={d.title}
      />
    ) : (
      <VideoEmbed
        src={d.video ?? ''}
        webm={d.videoWebm}
        poster={d.poster}
        caption={d.caption}
        aspectRatio={d.aspectRatio ?? '16/9'}
        title={d.title}
      />
    )}
  </div>
  <script>
    // Embed panel: show the iframe code; copy it, or select it for Cmd+C where
    // the host page blocks clipboard access.
    const toggle = document.querySelector<HTMLButtonElement>('.embed-code-toggle');
    const panel = document.getElementById('embed-code');
    const code = panel?.querySelector('textarea');
    const copy = panel?.querySelector<HTMLButtonElement>('.embed-copy');
    const setOpen = (open: boolean) => {
      if (!toggle || !panel) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) code?.select();
    };
    toggle?.addEventListener('click', () => setOpen(!!panel?.hidden));
    panel?.querySelector('.embed-close')?.addEventListener('click', () => setOpen(false));
    copy?.addEventListener('click', async () => {
      if (!code) return;
      code.select();
      let ok = false;
      try { await navigator.clipboard.writeText(code.value); ok = true; } catch { ok = document.execCommand('copy'); }
      copy.textContent = ok ? 'Copied' : 'Press Cmd+C to copy';
      setTimeout(() => (copy.textContent = 'Copy code'), 2000);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

    // Report our rendered height to the parent page so a host iframe can size
    // itself to the content. This keeps any aspect ratio (16/9, square, audio)
    // from letterboxing or clipping the caption, at any iframe width.
    // The host opts in with the small listener shown in EDITOR-GUIDE.md; without
    // it, the iframe just keeps its authored height (graceful fallback).
    const shell = document.getElementById('embed-shell');
    if (shell) {
      const postHeight = () => {
        const height = Math.ceil(shell.getBoundingClientRect().height);
        parent.postMessage({ type: 'civicinterplay:embed-size', height }, '*');
      };
      window.addEventListener('load', postHeight);
      if ('ResizeObserver' in window) {
        new ResizeObserver(postHeight).observe(shell);
      } else {
        window.addEventListener('resize', postHeight);
      }
    }
  </script>
</body>
</html>
