---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import AudioEmbed from '../components/AudioEmbed.astro';
import { CATEGORY_LABEL } from '../content/config';

export async function getStaticPaths() {
  // Drafts render in `npm run dev` so you can preview and write copy, but are
  // excluded from the production build (and from every listing). Set draft: true
  // in frontmatter to keep a post in this preview-only state.
  const posts = await getCollection('posts', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

// The label and breadcrumb follow the post's Section (set in the CMS), the
// same one that decides where it is listed.
const SECTIONS: Record<string, { label: string; colour: string; href: string; parent: string; parentHref: string }> = {
  essay: { label: 'Essay', colour: 'var(--purple)', href: '/reading/#essays', parent: 'Reading', parentHref: '/reading/' },
  note: { label: 'Field note', colour: 'var(--terracotta)', href: '/reading/#field-notes', parent: 'Reading', parentHref: '/reading/' },
  experiment: { label: 'Experiment', colour: 'var(--pink)', href: '/reading/#experiments', parent: 'Reading', parentHref: '/reading/' },
  project: { label: 'Project', colour: 'var(--purple)', href: '/projects/', parent: 'Projects', parentHref: '/projects/' },
};
const section = SECTIONS[post.data.section];
const tagColour = section?.colour ?? 'var(--text-dim)';
const categoryLabel = section?.label ?? '';

const formattedDate = post.data.publishedAt.toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
});
---
<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={post.data.featureImage}
  article={{
    type: post.data.articleType,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    tags: post.data.categories.map((c) => CATEGORY_LABEL[c]),
    keywords: post.data.keywords,
    about: post.data.keywords ?? post.data.categories.map((c) => CATEGORY_LABEL[c]),
  }}
>
  <article>
    <div class="narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Civic Interplay</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <a href={section?.parentHref ?? '/reading/'}>{section?.parent ?? 'Reading'}</a>
        {section && section.parent === 'Reading' && (
          <>
            <span class="breadcrumb-sep" aria-hidden="true">›</span>
            <a class="breadcrumb-current" href={section.href}>{section.label}s</a>
          </>
        )}
      </nav>

      <div class="post-header">
        {categoryLabel && (
          <div class="post-tag" style={`color: ${tagColour}`}>{categoryLabel}</div>
        )}
        <h1>{post.data.title}</h1>
        {(post.data.subtitle ?? post.data.excerpt) && (
          <p class="post-subtitle">{post.data.subtitle ?? post.data.excerpt}</p>
        )}
        <div class="post-meta">{formattedDate}</div>
      </div>

      {post.data.featureVideo ? (
        <VideoEmbed
          src={post.data.featureVideo}
          webm={post.data.featureVideoWebm}
          poster={post.data.featureImage}
          title={post.data.featureImageAlt}
          aspectRatio="auto"
        />
      ) : post.data.featureAudio ? (
        <AudioEmbed
          src={post.data.featureAudio}
          ogg={post.data.featureAudioOgg}
          poster={post.data.featureImage}
          posterAlt={post.data.featureImageAlt}
          title={post.data.featureImageAlt}
        />
      ) : post.data.featureImage && (
        <img
          src={post.data.featureImage}
          alt={post.data.featureImageAlt ?? ''}
          class:list={['post-feature-image', post.data.featureImageFit === 'full' && 'post-feature-image--full']}
          loading="eager"
          decoding="async"
        />
      )}

      <div class="post-content">
        <Content />
      </div>

      <div class="back-link">
        <a href="/reading/">Reading</a>
      </div>
    </div>
  </article>
</BaseLayout>
