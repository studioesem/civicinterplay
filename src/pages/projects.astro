---
import BaseLayout from '../layouts/BaseLayout.astro';

// MOCKUP: Projects, the new top-level menu item. Same two-column treatment as
// the home page slideshow, laid out as a list.

const slides = [
  {
    kicker: 'Shared records · Live',
    title: 'Data Centres Transparency Project',
    body: "A live map of the data centre build-out in Australia. Site by site: who owns the compute, what it draws in power and water, how it was approved, and what has been disclosed since. Records and method are published openly, with a DOI.",
    image: '/images/sovereignties-map-1200.webp',
    imageAlt: 'Map of data centre sites around Sydney, sized and coloured by power draw.',
    fit: 'cover',
    links: [
      { href: '/sovereignties/', label: 'Open the map' },
      { href: '/submission/', label: 'Read the Senate submission' },
    ],
    fill: '#1f1d24',
    ink: '#1f1d24',
  },
  {
    kicker: 'New project · A new kind of archive',
    title: 'Tracing public value: A side angle on a place',
    body: "A place pulled apart into three layers: what was promised for it, where money and approvals went, and what the public record shows happened next. Where the layers don't line up, there's a gap, and that is where the questions sit.",
    image: '/images/side-angle-plate.jpg',
    imageAlt: 'Experimental drawing: one precinct pulled apart into three stacked sheets. Value on top, flows in the middle, impact on the ground.',
    fit: 'contain',
    links: [{ href: '/experiments/side-angle-on-place-flows.html', label: 'Open the experiment' }],
    fill: 'var(--purple)',
    ink: 'var(--ink-purple)',
  },
  {
    kicker: 'Place',
    title: 'WeCare, City North',
    body: "A participatory digital storytelling project for RMIT's City North Social Innovation Precinct. Values co-designed with the people of the precinct, in their own words and images.",
    image: '/images/We-care-2.png',
    imageAlt: 'Artwork from WeCare: a woman standing against a pink background, with a quote about bringing everyone forward together on Country.',
    fit: 'contain',
    links: [{ href: '/we-care-rmit/', label: 'See WeCare' }],
    fill: 'var(--pink)',
    ink: 'var(--ink-pink)',
  },
  {
    kicker: 'Method',
    title: 'Gathering Intelligences',
    body: 'What if you could trace the relations of value that shape your place through time, and reflect on how these shape your own values and experiences? This is an experimental walking practice, assembling the digital and sensory conditions that shape attention to shared spaces in cities.',
    image: '/images/tiles/toolkit-560.webp',
    imageAlt: 'Field note card reading: Workflows and prompts, forkable.',
    fit: 'contain',
    links: [{ href: '/gathering-intelligences/', label: 'Start gathering' }],
    fill: 'var(--terracotta)',
    ink: 'var(--ink-terracotta)',
  },
];

// Gathering Intelligences before WeCare: the method sits with the work.
const order = ['Data Centres Transparency Project', 'Tracing public value: A side angle on a place', 'Gathering Intelligences', 'WeCare, City North'];
const projects = order.map((t) => slides.find((s) => s.title === t)!).filter(Boolean);
---
<BaseLayout title="Projects" description="Projects that examine how the digital architectures and conditions shaping a place are made more legible in public and community forums.">

  <main class="projects-page">
    <header>
      <p class="eyebrow">Projects &amp; Experiments</p>
      <h1>Projects</h1>
      <p class="standfirst">
        A selection of projects that examine how the digital architectures and
        conditions shaping a place are made more legible in public and
        community forums.
      </p>
    </header>

    <div class="list">
      {projects.map((sl, i) => (
        <article class="slide" style={`--fill:${sl.fill}; --ink:${sl.ink}`}>
          <div class={`slide-shot fit-${sl.fit}`}>
            <img src={sl.image} alt={sl.imageAlt} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="slide-text">
            <p class="slide-kicker">{sl.kicker}</p>
            <h2>{sl.title}</h2>
            <p class="slide-body">{sl.body}</p>
            <p class="slide-links">
              {sl.links.map((l, j) => (
                <a class={j === 0 ? 'slide-btn' : 'slide-link'} href={l.href}>{l.label} <span aria-hidden="true">&rarr;</span></a>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </main>

  <style>
    .projects-page {
      width: min(1320px, calc(100vw - 3rem));
      margin: 0 auto;
      padding: 2.5rem 0 4rem;
    }

    header {
      max-width: 760px;
      margin: 0 auto 2.5rem;
    }

    .eyebrow {
      font-family: var(--heading);
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--purple);
      margin: 0 0 0.5rem;
    }

    h1 {
      font-family: var(--heading);
      font-size: clamp(2rem, 4.5vw, 2.8rem);
      font-weight: var(--w-bold);
      line-height: 1.1;
      margin: 0 0 1rem;
    }

    .standfirst {
      font-family: var(--body);
      font-size: var(--fs-lead);
      font-weight: var(--w-light);
      line-height: 1.6;
      margin: 0;
    }

    .list {
      display: grid;
      gap: 2rem;
    }

    .slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      min-height: clamp(360px, 42vw, 520px);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 8px 8px 0 var(--fill);
      overflow: hidden;
      background: #fff;
    }

    .slide-shot {
      border-right: 2px solid var(--border);
      background: #fff;
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .slide-shot img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .fit-cover img { object-fit: cover; }

    .fit-contain { padding: 1.5rem; background: var(--bg); }
    .fit-contain img { object-fit: contain; max-height: 480px; }

    .slide-text {
      background: #fff;
      color: var(--text);
      padding: clamp(1.5rem, 4vw, 3rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
    }

    .slide-kicker {
      font-family: var(--heading);
      font-size: var(--fs-label);
      font-weight: var(--w-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--ink);
      margin: 0;
    }

    .slide h2 {
      font-family: var(--heading);
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: var(--w-bold);
      line-height: 1.1;
      margin: 0;
    }

    .slide-body {
      font-family: var(--body);
      font-weight: var(--w-light);
      line-height: 1.65;
      margin: 0;
      max-width: 46ch;
    }

    .slide-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.25rem;
      margin: 0.5rem 0 0;
    }

    .slide-btn {
      display: inline-flex;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: var(--ink);
      color: #fff;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 3px 3px 0 var(--border);
      font-family: var(--heading);
      font-weight: var(--w-bold);
      text-decoration: none;
    }

    .slide-link {
      font-family: var(--heading);
      font-weight: var(--w-medium);
      color: var(--ink);
      text-underline-offset: 4px;
    }


    @media (max-width: 860px) {
      .slide { grid-template-columns: minmax(0, 1fr); }
      .slide-shot { border-right: 0; border-bottom: 2px solid var(--border); aspect-ratio: 4 / 3; }
    }
  </style>
</BaseLayout>
