---
import Reflections from './Reflections.astro';
---
<footer class="site-footer">
  <div class="container container-wide footer-wf">
    <div>
      <img class="footer-device" src="/images/civic-interplay-device.png" alt="" width="1370" height="733" loading="lazy" />
      <div class="footer-title">Civic Interplay</div>
      <div class="footer-tagline">Place-based civic enquiry with digital and AI methods</div>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/reading/">Reading</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>
    <p class="footer-credit">
      <a href="https://cur.org.au/">
        <img class="footer-rmit" src="/images/partners/rmit-university.png" alt="RMIT University" width="720" height="253" loading="lazy" />
        <span>Centre for Urban Research</span>
      </a>
    </p>
  </div>
  <div class="container container-wide">
    <Reflections bare />
  </div>
</footer>

<style>
  .footer-wf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
    text-align: left;
  }

  .footer-wf .footer-links {
    justify-content: center;
  }

  .footer-credit {
    margin: 0;
    text-align: right;
    font-family: var(--heading);
    font-size: 0.82rem;
  }

  .footer-credit a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .footer-rmit {
    width: 120px;
    height: auto;
  }

  .footer-device {
    display: block;
    width: 72px;
    height: auto;
    margin-bottom: 0.6rem;
  }

  @media (max-width: 720px) {
    .footer-wf { grid-template-columns: minmax(0, 1fr); text-align: center; }
    .footer-credit { text-align: center; }
    .footer-credit a { align-items: center; }
    .footer-device { margin: 0 auto 0.6rem; }
  }
</style>
