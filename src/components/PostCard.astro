---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  category?: 'foundational-docs' | 'training-grounds' | 'essays-readings' | 'the-portals' | null;
  categoryLabel?: string;
  image?: string;
  imageAlt?: string;
  video?: string;
  videoWebm?: string;
  /** Kept for one-off overrides; the default fallback is the bike. */
  fallbackGradient?: string;
  /** Overrides the category default. Set per post when a card needs to read
      as something other than its category, e.g. a tool listed under Training
      Grounds should be cream like the tool tile above it. */
  accent?: 'cream' | 'purple' | 'terracotta' | 'periwinkle' | 'pink' | 'plain';
  /** Shown under the tag. Used on the Reading archive, where chronology matters. */
  date?: string;
}

const {
  href,
  title,
  excerpt,
  category,
  categoryLabel,
  image,
  imageAlt = '',
  video,
  videoWebm,
  fallbackGradient,
  accent,
  date,
} = Astro.props;

const catClass = category ? `cat-${category}` : '';

// Category sets the default accent; `accent` overrides it per card.
const accentByCategory: Record<string, string> = {
  'foundational-docs': 'purple',
  'training-grounds': 'terracotta',
  'essays-readings': 'periwinkle',
  'the-portals': 'pink',
};
const accentClass = `accent-${accent ?? (category ? accentByCategory[category] : 'plain')}`;

// Posts without artwork get the bike rather than an abstract mark. An asterisk
// in terracotta read as the Anthropic logo, which is not a thing to imply.
const FALLBACK_IMAGE = '/images/bike.jpg';
const FALLBACK_ALT =
  'A road bicycle mounted high on a pole against a purple and blue sky, with coloured circles overlaid.';
const cardImage = image ?? (video ? undefined : FALLBACK_IMAGE);
const cardImageAlt = image ? imageAlt : FALLBACK_ALT;

---
<a href={href} class={`post-card ${catClass} ${accentClass}`.trim()}>
  {video ? (
    <video
      class="post-card-video"
      poster={image}
      muted
      loop
      playsinline
      preload="none"
      aria-label={imageAlt}
      data-card-video
    >
      {videoWebm && <source src={videoWebm} type="video/webm" />}
      <source src={video} type="video/mp4" />
    </video>
  ) : fallbackGradient && !image ? (
    <div class="img-placeholder" style={`background: ${fallbackGradient};`}></div>
  ) : (
    <img src={cardImage} alt={cardImageAlt} class="post-card-image" loading="lazy" decoding="async" />
  )}
  {(categoryLabel || date) && (
    <div class="post-card-tag">
      {categoryLabel}{categoryLabel && date && <span class="post-card-dot"> · </span>}{date}
    </div>
  )}
  <h3>{title}</h3>
  {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
</a>

<style>
  /* Same chrome as the home-page tiles: 2px rule, hard offset shadow, lift on
     hover. The accent classes in global.css supply the fill and the ink. */
  .post-card {
    background: var(--card-bg, #fffefc);
    color: var(--card-ink, var(--text));
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 4px 4px 0 var(--border);
    padding: 1.1rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 7px 7px 0 var(--border);
  }

  .post-card:focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: 3px;
  }

  .img-placeholder,
  .post-card-image,
  .post-card-video {
    width: 100%;
    height: 190px;
    border-radius: 6px;
    border: 2px solid var(--card-edge, var(--border-light));
    margin-bottom: 0.9rem;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--card-edge, var(--sand));
  }

  .img-placeholder {
    background: var(--card-edge, var(--sand));
  }



  .post-card-tag {
    font-family: var(--heading);
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
    color: var(--card-kicker, var(--text-faint));
  }

  .post-card-dot {
    opacity: 0.55;
  }

  .post-card h3 {
    font-family: var(--heading);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    transition: color 0.3s;
  }

  .post-card:hover h3 {
    color: var(--card-hover-ink, var(--purple));
  }

  .post-card-excerpt {
    font-size: 0.82rem;
    font-weight: 300;
    color: var(--card-ink-dim, var(--text-dim));
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Only play card videos when they enter the viewport. Keeps bandwidth and
  // CPU sensible on a feed of cards. Pauses on reduced-motion entirely.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-card-video]');

  if (reduceMotion) {
    videos.forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const v = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          v.play().catch(() => { /* autoplay can be blocked; poster remains */ });
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '50px', threshold: 0.25 });
    videos.forEach((v) => io.observe(v));
  } else {
    videos.forEach((v) => v.play().catch(() => {}));
  }
</script>
