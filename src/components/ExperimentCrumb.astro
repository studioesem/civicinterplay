---
// Back link at the top of the standalone experiment pages, which don't carry
// the site header. Colours come from each page's own variables.
---
<nav class="crumb" aria-label="Breadcrumb">
  <a href="/projects/#tools"><span aria-hidden="true">←</span> Tools &amp; experiments</a>
</nav>

<style>
  .crumb {
    margin: 0 0 1.4rem;
    font: 500 .85rem var(--display, "Fira Sans", system-ui, sans-serif);
  }
  .crumb a {
    color: var(--line, #6f6a76);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .crumb a:hover,
  .crumb a:focus-visible {
    color: var(--permit, #7D50BD);
    border-bottom-color: currentColor;
  }
</style>
