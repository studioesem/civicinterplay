---
const path = Astro.url.pathname;
const starts = (...prefixes: string[]) => prefixes.some((p) => path.startsWith(p));

const nav = [
  { href: '/', label: 'Home', on: path === '/' || path === '' },
  { href: '/reading/', label: 'Reading', on: starts('/reading', '/field-notes', '/listening') },
  {
    href: '/projects/',
    label: 'Projects',
    // The projects themselves light this up too.
    on: starts('/projects', '/gathering-intelligences', '/sovereignties', '/data-centres-map', '/submission', '/facts-and-moments', '/we-care-rmit', '/terrain'),
  },
  { href: '/about/', label: 'About', on: starts('/about', '/proposition') },
];
---
<header class="site-header">
  <div class="container container-wide">
    <div class="header-inner">
      <a href="/" class="site-logo" aria-label="Civic Interplay home">
        <span>Civic Interplay</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav-links">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Chromatic-aberration hover on the wordmark, reusing the site-wide `glitch`
     keyframes from global.css. Same move as the hero, at nav scale. */
  .site-logo span {
    display: inline-block;
  }

  .site-logo:hover span,
  .site-logo:focus-visible span {
    animation: glitch 0.4s steps(2) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-logo:hover span,
    .site-logo:focus-visible span {
      animation: none;
    }
  }
</style>
